          <SourceLine>Next</SourceLine>
          <SourceLine/>
          <SourceLine>// Display log output at high verbosity levels</SourceLine>
          <SourceLine>If App.InfobarEventDetails &gt;= 3 Then</SourceLine>
          <SourceLine>// Download Queue Contents</SourceLine>
          <SourceLine>System.DebugLog("[Download Queue Contents]")</SourceLine>
          <SourceLine>For i As Integer = App.DownloadList.Ubound - 1 DownTo 0</SourceLine>
          <SourceLine>System.DebugLog(App.DownloadList(i))</SourceLine>
          <SourceLine>Next</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>// Clear the item from the download queue</SourceLine>
          <SourceLine>For i As Integer = App.DownloadList.Ubound - 1 DownTo 0</SourceLine>
          <SourceLine>If App.DownloadList(i) = App.DownloadAtomID Then </SourceLine>
          <SourceLine>App.DownloadList.Remove(i)</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>Next</SourceLine>
          <SourceLine/>
          <SourceLine>// Clear the item after clearing the queue contents</SourceLine>
          <SourceLine>App.DownloadAtomID = ""</SourceLine>
          <SourceLine/>
          <SourceLine>// Refresh the cell contents to update the number count</SourceLine>
          <SourceLine>App.JSONStateCount.Value("Downloading") = App.DownloadList.Count</SourceLine>
          <SourceLine>For row As Integer = StateListBox.RowCount -1 DownTo 0</SourceLine>
          <SourceLine>StateListBox.RefreshCell(row, 0)</SourceLine>
          <SourceLine>Next</SourceLine>
          <SourceLine/>
          <SourceLine>End Sub</SourceLine>
