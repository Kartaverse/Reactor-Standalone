          <SourceLine>// Display log output at high verbosity levels</SourceLine>
          <SourceLine>If App.InfobarEventDetails &gt;= 3 Then</SourceLine>
          <SourceLine>System.DebugLog("[Download URL] " + ZipFileURL + EndOfLine + "[Download Filepath] " + AtomzFile.NativePath + " [Download File] " + App.DownloadFilename)</SourceLine>
