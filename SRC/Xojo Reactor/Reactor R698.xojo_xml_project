        <SourceLine>Do</SourceLine>
        <SourceLine>// Read a row from the text file</SourceLine>
        <SourceLine>oneLine = fileStream.ReadLine()</SourceLine>
        <SourceLine/>
        <SourceLine>// Remove the zip file extension from the atom package filename</SourceLine>
        <SourceLine>Var re As New RegEx</SourceLine>
        <SourceLine>re.SearchPattern = "[.]zip$"</SourceLine>
        <SourceLine>re.ReplacementPattern = ""</SourceLine>
        <SourceLine>re.Options.ReplaceAllMatches = True</SourceLine>
        <SourceLine>Var destName As String = re.Replace(oneLine)</SourceLine>
        <SourceLine/>
        <SourceLine>// Add the atom package to the download queue list</SourceLine>
        <SourceLine>App.DownloadList().Add(destName)</SourceLine>
        <SourceLine>Loop Until fileStream.EndOfFile</SourceLine>
        <SourceLine>fileStream.Close</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>// Fallback</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Catch error As IOException</SourceLine>
        <SourceLine>// Handle IO error</SourceLine>
        <SourceLine>// Display log output at medium verbosity levels</SourceLine>
        <SourceLine>If App.InfobarEventDetails &gt;= 2 Then</SourceLine>
        <SourceLine>// MessageBox(error.Message)</SourceLine>
        <SourceLine>DownloadStatsLabel.Text = error.Message</SourceLine>
        <SourceLine>ConsoleWindow.Console.AddText(ReactorWindow.DownloadStatsLabel.Text + EndOfLine)</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Catch error As NilObjectException</SourceLine>
        <SourceLine>// Display log output at medium verbosity levels</SourceLine>
        <SourceLine>If App.InfobarEventDetails &gt;= 2 Then</SourceLine>
        <SourceLine>// MessageBox(error.Message)</SourceLine>
        <SourceLine>DownloadStatsLabel.Text = error.Message</SourceLine>
        <SourceLine>ConsoleWindow.Console.AddText(ReactorWindow.DownloadStatsLabel.Text + EndOfLine)</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>End Try</SourceLine>
        <SourceLine/>
        <SourceLine>// De-duplicate array entries</SourceLine>
        <SourceLine>App.DownloadList.Sort</SourceLine>
        <SourceLine>For i As Integer = App.DownloadList.Ubound - 1 DownTo 0</SourceLine>
        <SourceLine>if App.DownloadList(i) = App.DownloadList(i + 1) Then App.DownloadList.Remove(i)</SourceLine>
        <SourceLine>Next</SourceLine>
        <SourceLine/>
        <SourceLine>// Switch to the download view mode</SourceLine>
        <SourceLine>StateListBox.SelectedRowIndex = 8</SourceLine>
        <SourceLine/>
        <SourceLine>// Clear out the search text field</SourceLine>
        <SourceLine>AtomSearchField.Text = ""</SourceLine>
        <SourceLine/>
        <SourceLine>// Set the category back to "Any Category"</SourceLine>
        <SourceLine>If CategoryListbox.RowCount &gt;= 1 Then</SourceLine>
        <SourceLine>CategoryListbox.SelectedRowIndex = 0</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Update the number next to the state rows</SourceLine>
        <SourceLine>RefreshStateCount()</SourceLine>
        <SourceLine/>
        <SourceLine>// Update the number next to the category rows</SourceLine>
        <SourceLine>RefreshCategoryCount()</SourceLine>
        <SourceLine/>
        <SourceLine>// Show the newly added packages in the "Downloading" view mode</SourceLine>
        <SourceLine>RefreshAtoms()</SourceLine>
        <SourceLine>Case LST_Load_Dialog.AlternateActionButton</SourceLine>
        <SourceLine>// Use Local Atomz Packages</SourceLine>
        <SourceLine>Case LST_Load_Dialog.CancelButton</SourceLine>
        <SourceLine>// User pressed "Cancel"</SourceLine>
        <SourceLine>End Select</SourceLine>
        <SourceLine/>
        <SourceLine>End Sub</SourceLine>
