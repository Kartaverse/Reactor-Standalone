    <Method>
      <ItemName>LoadSettings</ItemName>
      <Compatibility/>
      <Visible>1</Visible>
      <PartID>1657985023</PartID>
      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub LoadSettings()</SourceLine>
        <SourceLine>// Load JSON Preferences</SourceLine>
        <SourceLine>Var programName As String = "Reactor.json"</SourceLine>
        <SourceLine/>
        <SourceLine>// Create the prefs folder</SourceLine>
        <SourceLine>Var prefsFolder As FolderItem</SourceLine>
        <SourceLine>Try</SourceLine>
        <SourceLine>If TargetMacOS or TargetWindows Then</SourceLine>
        <SourceLine>prefsFolder = SpecialFolder.ApplicationData.Child("Reactor")</SourceLine>
        <SourceLine>If Not prefsFolder.Exists Then</SourceLine>
        <SourceLine>prefsFolder.CreateFolder</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>ElseIf TargetLinux Then</SourceLine>
        <SourceLine>If Not SpecialFolder.UserHome.Child(".config").Exists Then</SourceLine>
        <SourceLine>SpecialFolder.UserHome.Child(".config").CreateFolder</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>prefsFolder = SpecialFolder.UserHome.Child(".config").Child("Reactor")</SourceLine>
        <SourceLine>If Not prefsFolder.Exists Then</SourceLine>
        <SourceLine>prefsFolder.CreateFolder</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>End</SourceLine>
        <SourceLine>Catch error As IOException</SourceLine>
        <SourceLine>// Handle IO error</SourceLine>
        <SourceLine>// Display log output at medium verbosity levels</SourceLine>
        <SourceLine>If App.InfobarEventDetails &gt;= 2 Then</SourceLine>
        <SourceLine>// MessageBox("[Load Settings] " + error.Message + " - " + prefsFolder.NativePath)</SourceLine>
        <SourceLine>ReactorWindow.DownloadStatsLabel.Text = "[Load Settings] " + error.Message + " - " + prefsFolder.NativePath</SourceLine>
        <SourceLine>ConsoleWindow.Console.AddText(ReactorWindow.DownloadStatsLabel.Text + EndOfLine)</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>End Try</SourceLine>
        <SourceLine/>
        <SourceLine>// Read the Window_Prefs.json file from the prefs folder</SourceLine>
        <SourceLine>Var prefsFile As FolderItem = prefsFolder.Child(programName)</SourceLine>
        <SourceLine>If prefsFile &lt;&gt; Nil And prefsFile.Exists Then</SourceLine>
        <SourceLine>Try</SourceLine>
        <SourceLine>// Create the file pointer</SourceLine>
        <SourceLine>Var fileStream As TextInputStream = TextInputStream.Open(prefsFile)</SourceLine>
        <SourceLine>If fileStream &lt;&gt; Nil Then</SourceLine>
        <SourceLine>// Read the full text file in one block</SourceLine>
        <SourceLine>Var textData As String = fileStream.ReadAll</SourceLine>
        <SourceLine>// MessageBox(textData)</SourceLine>
        <SourceLine>Try</SourceLine>
        <SourceLine>// Create a new JSON object hierarchy</SourceLine>
        <SourceLine>Var json As New JSONItem(textData)</SourceLine>
        <SourceLine>json.Compact = False</SourceLine>
        <SourceLine>Var Val As String</SourceLine>
        <SourceLine/>
        <SourceLine>// Load the JSON into the settings property</SourceLine>
        <SourceLine>App.Settings = json</SourceLine>
        <SourceLine/>
        <SourceLine>// MessageBox(json.ToString)</SourceLine>
        <SourceLine>If App.InfobarEventDetails &gt;= 3 Then</SourceLine>
        <SourceLine>System.DebugLog("[Settings Read] " + prefsFile.NativePath)</SourceLine>
        <SourceLine>System.DebugLog("[Settings JSON Data] ")</SourceLine>
        <SourceLine>System.DebugLog(json.ToString)</SourceLine>
        <SourceLine/>
        <SourceLine>ConsoleWindow.Console.AddText("[Settings Read] " + prefsFile.NativePath + EndOfLine)</SourceLine>
        <SourceLine>ConsoleWindow.Console.AddText("[Settings JSON Data] " + EndOfLine)</SourceLine>
        <SourceLine>ConsoleWindow.Console.AddText(json.ToString + EndOfLine)</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Catch error As JSONException</SourceLine>
        <SourceLine>// Fallback Resolution</SourceLine>
        <SourceLine>CreateDefaultSettings()</SourceLine>
        <SourceLine>End Try</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>// Fallback</SourceLine>
        <SourceLine>CreateDefaultSettings()</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Catch error As IOException</SourceLine>
        <SourceLine>// Handle IO error</SourceLine>
        <SourceLine>CreateDefaultSettings()</SourceLine>
        <SourceLine>App.GamepadSupport = 0</SourceLine>
        <SourceLine>// Display log output at medium verbosity levels</SourceLine>
        <SourceLine>If App.InfobarEventDetails &gt;= 2 Then</SourceLine>
        <SourceLine>// MessageBox(error.Message)</SourceLine>
        <SourceLine>ReactorWindow.DownloadStatsLabel.Text = error.Message</SourceLine>
        <SourceLine>ConsoleWindow.Console.AddText(ReactorWindow.DownloadStatsLabel.Text + EndOfLine)</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Catch error As JSONException</SourceLine>
        <SourceLine>// Fallback </SourceLine>
        <SourceLine>CreateDefaultSettings()</SourceLine>
        <SourceLine>App.GamepadSupport = 0</SourceLine>
        <SourceLine>End Try</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>// Fallback</SourceLine>
        <SourceLine>CreateDefaultSettings()</SourceLine>
        <SourceLine>App.GamepadSupport = 0</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Check if the settings exist</SourceLine>
        <SourceLine>If App.Settings = Nil Then</SourceLine>
        <SourceLine>CreateDefaultSettings()</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Reactor License Accepted</SourceLine>
        <SourceLine>If App.Settings &lt;&gt; Nil and App.Settings.HasKey("LicenseAccepted") Then</SourceLine>
        <SourceLine>Var Val As String = App.Settings.Value("LicenseAccepted")</SourceLine>
        <SourceLine>App.LicenseAccepted = Val.ToBoolean</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>App.LicenseAccepted = False</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Info bar logging detail level</SourceLine>
        <SourceLine>If App.Settings &lt;&gt; Nil and App.Settings.HasKey("InfobarEventDetails") Then</SourceLine>
        <SourceLine>Var Val As String = App.Settings.Value("InfobarEventDetails")</SourceLine>
        <SourceLine>App.InfobarEventDetails = Val.ToInteger</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>App.InfobarEventDetails = 2</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Gamepad support</SourceLine>
        <SourceLine>If App.Settings &lt;&gt; Nil and App.Settings.HasKey("GamepadSupport") Then</SourceLine>
        <SourceLine>Var Val As String = App.Settings.Value("GamepadSupport")</SourceLine>
        <SourceLine>App.GamepadSupport = Val.ToInteger</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>App.GamepadSupport = 0</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Atom Search</SourceLine>
        <SourceLine>If App.Settings &lt;&gt; Nil and App.Settings.HasKey("LiveSearch") Then</SourceLine>
        <SourceLine>Var Val As String = App.Settings.Value("LiveSearch")</SourceLine>
        <SourceLine>App.LiveSearch = Val.ToBoolean</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>App.LiveSearch  = False</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Number of days an atom is marked as new</SourceLine>
        <SourceLine>If App.Settings &lt;&gt; Nil and App.Settings.HasKey("NewForDays") Then</SourceLine>
        <SourceLine>App.NewForDays = App.Settings.Value("NewForDays")</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>App.NewForDays = 30</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>If App.Settings &lt;&gt; Nil and App.Settings.HasKey("MarkAsNew") Then</SourceLine>
        <SourceLine>App.MarkAsNew = App.Settings.Value("MarkAsNew")</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>App.MarkAsNew = True</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Window Size</SourceLine>
        <SourceLine>If App.Settings &lt;&gt; Nil And App.Settings.HasKey("MainWindow") Then</SourceLine>
        <SourceLine>Var jsonWindow As JSONItem = App.Settings.Value("MainWindow")</SourceLine>
        <SourceLine>If jsonWindow.HasKey("Width") And jsonWindow.HasKey("Height") Then</SourceLine>
        <SourceLine>ReactorWindow.Width = jsonWindow.Value("Width")</SourceLine>
        <SourceLine>ReactorWindow.Height = jsonWindow.Value("Height")</SourceLine>
        <SourceLine>// Display log output at high verbosity levels</SourceLine>
        <SourceLine>If App.InfobarEventDetails &gt;= 3 Then</SourceLine>
        <SourceLine>System.DebugLog("[Main Window Size] " + ReactorWindow.Width.ToString + "x" + ReactorWindow.Height.ToString)</SourceLine>
        <SourceLine>ConsoleWindow.Console.AddText("[Main Window Size] " + ReactorWindow.Width.ToString + "x" + ReactorWindow.Height.ToString + EndOfLine)</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Reactor Standalone Files Location</SourceLine>
        <SourceLine>// Todo: Possibly read the env variable for "ReactorInstallPathMap" to allow it to override the prefs file</SourceLine>
        <SourceLine>Try</SourceLine>
        <SourceLine>If App.Settings &lt;&gt; Nil and App.Settings.HasKey("ReactorInstallPathMap") Then</SourceLine>
        <SourceLine>Var Val As String = App.Settings.Value("ReactorInstallPathMap")</SourceLine>
        <SourceLine>Var ReactorFolderItem As FolderItem = New FolderItem(Val)</SourceLine>
        <SourceLine>App.ReactorFolder = ReactorFolderItem </SourceLine>
        <SourceLine/>
        <SourceLine>// Create the intermediate sub-directories for the Reactor folder</SourceLine>
        <SourceLine>App.CreateSubFolders(ReactorFolderItem)</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>// Fallback to using the home folder</SourceLine>
        <SourceLine>App.ReactorFolder = SpecialFolder.UserHome.Child("Reactor")</SourceLine>
        <SourceLine/>
        <SourceLine>// Create the intermediate sub-directories for the Reactor folder</SourceLine>
        <SourceLine>App.CreateSubFolders(App.ReactorFolder)</SourceLine>
        <SourceLine/>
        <SourceLine>// Display log output at high verbosity levels</SourceLine>
        <SourceLine>If App.InfobarEventDetails &gt;= 3 Then</SourceLine>
        <SourceLine>System.DebugLog("[Settings Read] No ReactorInstallPathMap entry found in settings file.")</SourceLine>
        <SourceLine>ConsoleWindow.Console.AddText("[Settings Read] No ReactorInstallPathMap entry found in settings file." + EndOfLine)</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Catch error As IOException</SourceLine>
        <SourceLine>// Display log output at medium verbosity levels</SourceLine>
        <SourceLine>If App.InfobarEventDetails &gt;= 2 Then</SourceLine>
        <SourceLine>// MessageBox("[Load Settings] " + error.Message)</SourceLine>
        <SourceLine>ReactorWindow.DownloadStatsLabel.Text = "[Load Settings] " + error.Message</SourceLine>
        <SourceLine>ConsoleWindow.Console.AddText(ReactorWindow.DownloadStatsLabel.Text + EndOfLine)</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>End Try</SourceLine>
        <SourceLine/>
        <SourceLine>// JustCropIt CSS Body Color</SourceLine>
        <SourceLine>// #282828;  (Has a +10/+10/+10 RGB offset compared to the category listbox RGB value to fix color shifts)</SourceLine>
        <SourceLine>// CSS Body Text Color  Light Grey</SourceLine>
        <SourceLine>// #969696;</SourceLine>
        <SourceLine>// "body {font-family: Arial, Helvetica, sans-serif; font-size:12px; font-weight:400; font-style:normal; background-color: #28282E; color: #969696;} " +_ </SourceLine>
        <SourceLine/>
        <SourceLine>// HTML Code blocks</SourceLine>
        <SourceLine>App.Header = "&lt;html&gt; " +_ </SourceLine>
        <SourceLine>"&lt;head&gt; " +_ </SourceLine>
        <SourceLine>"&lt;meta name=""qrichtext"" content=""1"" /&gt; " +_ </SourceLine>
        <SourceLine>"&lt;style type=""text/css""&gt; " +_ </SourceLine>
        <SourceLine>"body {font-family: Arial, Helvetica, sans-serif; font-size:12px; font-weight:400; font-style:normal; background-color: #282828; color: #C7C7C7;} " +_  </SourceLine>
        <SourceLine>"p, li { font-family: Arial, Helvetica, sans-serif; white-space: pre-wrap; } " +_ </SourceLine>
        <SourceLine>"p { margin-top:18px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; } " +_ </SourceLine>
        <SourceLine>"h1 {font-size:xx-large; font-weight:600;} " +_ </SourceLine>
        <SourceLine>"h2 {font-size:x-large; font-weight:600;} " +_ </SourceLine>
        <SourceLine>"h3 {font-size:large; font-weight:600;} " +_ </SourceLine>
        <SourceLine>"a {color: #98A6DD;} " +_ </SourceLine>
        <SourceLine>"&lt;/style&gt; " +_ </SourceLine>
        <SourceLine>"&lt;/head&gt; " +_ </SourceLine>
        <SourceLine>"&lt;body&gt; "</SourceLine>
        <SourceLine>App.Footer = "&lt;/body&gt;&lt;/html&gt;"</SourceLine>
        <SourceLine/>
        <SourceLine>// Rebuild the Reactor folder hiearchy</SourceLine>
        <SourceLine>App.CreateReactorFolders()</SourceLine>
        <SourceLine/>
        <SourceLine>// Control the gamepad Input timer</SourceLine>
        <SourceLine>If App.GamepadSupport = 1 Then</SourceLine>
        <SourceLine>ReactorWindow.TimerInputDevices.Enabled = True</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>ReactorWindow.TimerInputDevices.Enabled = False</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// LightWave Preferences</SourceLine>
        <SourceLine>If TargetMacOS Then</SourceLine>
        <SourceLine>App.LightWaveFolderPath = "/Applications/LightWaveDigital/LightWave3D_2025.0.2"</SourceLine>
        <SourceLine>ElseIf TargetWindows Then</SourceLine>
        <SourceLine>App.LightWaveFolderPath = "C:\Program Files\LightWave3D_2025.0.2\"</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine/>
        <SourceLine>End Sub</SourceLine>
