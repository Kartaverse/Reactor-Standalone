        <ItemSource>
          <TextEncoding>134217984</TextEncoding>
          <SourceLine>Sub SelectionChanged()</SourceLine>
          <SourceLine>// Avoid zero listbox rows being selected</SourceLine>
          <SourceLine>If Me.RowCount &gt;= 1 and Me.SelectedRowIndex = -1  Then</SourceLine>
          <SourceLine>Me.SelectedRowIndex = 0</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>// Display active selection</SourceLine>
          <SourceLine>If Me.RowCount &gt;= 1 and Me.SelectedRowIndex &lt;&gt; -1  Then</SourceLine>
          <SourceLine>// Display log output at high verbosity levels</SourceLine>
          <SourceLine>If App.InfobarEventDetails &gt;= 3 Then</SourceLine>
          <SourceLine>Var SelectedMode As String = Me.CellTextAt(Me.SelectedRowIndex, 0)</SourceLine>
          <SourceLine>System.DebugLog(SelectedMode + " State Selected")</SourceLine>
          <SourceLine>DownloadStatsLabel.Text = SelectedMode + " State Selected"</SourceLine>
          <SourceLine>DownloadStatsLabel.Refresh(False)</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>// Update the number next to the state rows</SourceLine>
          <SourceLine>RefreshStateCount()</SourceLine>
          <SourceLine/>
          <SourceLine>// Update the number next to the category rows</SourceLine>
          <SourceLine>RefreshCategoryCount()</SourceLine>
          <SourceLine/>
          <SourceLine>// Rebuild the atoms list</SourceLine>
          <SourceLine>RefreshAtoms()</SourceLine>
          <SourceLine/>
          <SourceLine>// Push the input focus to the atom description views</SourceLine>
          <SourceLine>DescriptionHTMLViewer.SetFocus()</SourceLine>
          <SourceLine/>
          <SourceLine>End Sub</SourceLine>
