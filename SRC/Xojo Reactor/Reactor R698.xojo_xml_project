        <SourceLine>Settings_Dialog.AlternateActionButton.Caption = "Yes"</SourceLine>
        <SourceLine>Settings_Dialog.Message = "Do you want to reset the Reactor Settings JSON file to its initial default values?"</SourceLine>
        <SourceLine>Var Settings_Dialog_Button As MessageDialogButton</SourceLine>
        <SourceLine>Settings_Dialog_Button = Settings_Dialog.ShowModal</SourceLine>
        <SourceLine>Select Case Settings_Dialog_Button</SourceLine>
        <SourceLine>Case Settings_Dialog.ActionButton</SourceLine>
        <SourceLine>// User pressed "No"</SourceLine>
        <SourceLine>Case Settings_Dialog.AlternateActionButton</SourceLine>
        <SourceLine>App.CreateDefaultSettings()</SourceLine>
        <SourceLine>App.SaveSettings()</SourceLine>
        <SourceLine>Case Settings_Dialog.CancelButton</SourceLine>
        <SourceLine>// User pressed "Cancel"</SourceLine>
        <SourceLine>End Select</SourceLine>
        <SourceLine/>
        <SourceLine>Return True</SourceLine>
        <SourceLine>End Function</SourceLine>
