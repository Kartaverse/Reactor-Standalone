      <HookInstance>
        <ItemName>SelectionChanged</ItemName>
        <Compatibility/>
        <Visible>1</Visible>
        <PartID>44480511</PartID>
        <ItemSource>
          <TextEncoding>134217984</TextEncoding>
          <SourceLine>Sub SelectionChanged()</SourceLine>
          <SourceLine>// Avoid zero listbox rows being selected</SourceLine>
          <SourceLine>If Me.RowCount &gt;= 1 and Me.SelectedRowIndex = -1  Then</SourceLine>
          <SourceLine>Me.SelectedRowIndex = 0</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>// Row selection bold highlight</SourceLine>
          <SourceLine>For r As Integer = Me.RowCount -1 DownTo 0</SourceLine>
          <SourceLine>if Me.SelectedRowIndex = r Then</SourceLine>
          <SourceLine>Me.CellBoldAt(r, 0) = True</SourceLine>
          <SourceLine>Else</SourceLine>
          <SourceLine>Me.CellBoldAt(r, 0) = False</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>Next</SourceLine>
          <SourceLine/>
          <SourceLine>// Display log output at medium verbosity levels</SourceLine>
          <SourceLine>If App.InfobarEventDetails &gt;= 2 Then</SourceLine>
          <SourceLine>If Me.RowCount &gt;= 1 and Me.SelectedRowIndex &lt;&gt; -1  Then</SourceLine>
          <SourceLine>Var SelectedMode As String = Me.CellTextAt(Me.SelectedRowIndex, 0)</SourceLine>
          <SourceLine>System.DebugLog(SelectedMode + " Category Selected")</SourceLine>
          <SourceLine>DownloadStatsLabel.Text = SelectedMode + " Category Selected"</SourceLine>
          <SourceLine>ConsoleWindow.Console.AddText(ReactorWindow.DownloadStatsLabel.Text + EndOfLine)</SourceLine>
          <SourceLine>DownloadStatsLabel.Refresh(False)</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>// Update the number next to the state rows</SourceLine>
          <SourceLine>RefreshStateCount()</SourceLine>
          <SourceLine/>
          <SourceLine>// Update the number next to the category rows</SourceLine>
          <SourceLine>RefreshCategoryCount()</SourceLine>
          <SourceLine/>
          <SourceLine>// Rebuild the atoms list</SourceLine>
          <SourceLine>RefreshAtoms()</SourceLine>
          <SourceLine/>
          <SourceLine>// Push the input focus to the atom description views</SourceLine>
          <SourceLine>DescriptionHTMLViewer.SetFocus()</SourceLine>
          <SourceLine/>
          <SourceLine>End Sub</SourceLine>
        </ItemSource>
      </HookInstance>
      <HookInstance>
        <ItemName>PaintCellBackground</ItemName>
        <Compatibility/>
        <Visible>1</Visible>
        <PartID>1801525247</PartID>
        <ItemSource>
          <TextEncoding>134217984</TextEncoding>
          <SourceLine>Function PaintCellBackground(g As Graphics, row As Integer, column As Integer) As Boolean</SourceLine>
          <SourceLine>// JustCropIt ListBox Grey BG</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(30, 30, 30)</SourceLine>
          <SourceLine>g.FillRectangle(0, 0, g.Width, g.Height)</SourceLine>
          <SourceLine/>
          <SourceLine>// JustCropIt Dark Grey Outline Stroke</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(21, 21, 21)</SourceLine>
          <SourceLine>g.DrawLine(g.Width - 1, 0, g.Width - 1, g.Height)</SourceLine>
          <SourceLine/>
