          <SourceLine>g.FillRectangle(0, 0, g.Width, g.Height)</SourceLine>
          <SourceLine>ElseIf row Mod 2 = 0 Then</SourceLine>
          <SourceLine>// Secondary Row Shading</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(41, 41, 41)</SourceLine>
          <SourceLine>g.FillRectangle(0, 0, g.Width, g.Height)</SourceLine>
          <SourceLine>Else</SourceLine>
          <SourceLine>// Primary Row Shading</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(34, 34, 34)</SourceLine>
          <SourceLine>g.FillRectangle(0, 0, g.Width, g.Height)</SourceLine>
          <SourceLine>End If</SourceLine>
