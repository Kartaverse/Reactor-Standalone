          <SourceLine>// If App.InfobarEventDetails &gt;= 1 Then</SourceLine>
          <SourceLine>If DownloadStatsLabel.Text &lt;&gt; "Ready" Then</SourceLine>
          <SourceLine>DownloadStatsLabel.Text = "Ready"</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>// End If</SourceLine>
          <SourceLine/>
          <SourceLine>// Make the button inactive when the queue is empty</SourceLine>
