        <SourceLine>Function ScriptsResetSettingstoDefaults() As Boolean</SourceLine>
        <SourceLine>Var Settings_Dialog As New MessageDialog</SourceLine>
        <SourceLine>Settings_Dialog.IconType = MessageDialog.IconTypes.Question</SourceLine>
        <SourceLine>Settings_Dialog.ActionButton.Caption = "No"</SourceLine>
        <SourceLine>//Settings_Dialog.CancelButton.Visible = True</SourceLine>
