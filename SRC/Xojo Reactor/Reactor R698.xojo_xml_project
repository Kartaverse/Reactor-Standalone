        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub ActionStateDown()</SourceLine>
        <SourceLine>// R2 = StateDown</SourceLine>
        <SourceLine>Select Case StateListBox.SelectedRowIndex</SourceLine>
        <SourceLine>Case 0</SourceLine>
        <SourceLine>// All</SourceLine>
        <SourceLine>StateListBox.SelectedRowIndex = 1</SourceLine>
        <SourceLine>Case 1</SourceLine>
        <SourceLine>// Update</SourceLine>
        <SourceLine>StateListBox.SelectedRowIndex = 2</SourceLine>
        <SourceLine>Case 2</SourceLine>
        <SourceLine>// Installed</SourceLine>
        <SourceLine>StateListBox.SelectedRowIndex = 3</SourceLine>
        <SourceLine>Case 3</SourceLine>
        <SourceLine>// Uninstalled</SourceLine>
        <SourceLine>StateListBox.SelectedRowIndex = 4</SourceLine>
        <SourceLine>Case 4</SourceLine>
        <SourceLine>// Donate</SourceLine>
        <SourceLine>StateListBox.SelectedRowIndex = 5</SourceLine>
        <SourceLine>Case 5</SourceLine>
        <SourceLine>// New</SourceLine>
        <SourceLine>StateListBox.SelectedRowIndex = 6</SourceLine>
        <SourceLine>Case 6</SourceLine>
        <SourceLine>// Dependencies</SourceLine>
        <SourceLine>StateListBox.SelectedRowIndex = 8</SourceLine>
        <SourceLine>Case 7</SourceLine>
        <SourceLine>// Incompatible</SourceLine>
        <SourceLine>StateListBox.SelectedRowIndex = 0</SourceLine>
        <SourceLine>Case 8</SourceLine>
        <SourceLine>// Downloading</SourceLine>
        <SourceLine>StateListBox.SelectedRowIndex = 0</SourceLine>
        <SourceLine>End Select</SourceLine>
        <SourceLine>End Sub</SourceLine>
