      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub AtomRemoveByRow(row As Integer)</SourceLine>
        <SourceLine>If row &gt;= 0 Then</SourceLine>
        <SourceLine>// Handle macOS not adding a slash on FolderItem NativePath output</SourceLine>
        <SourceLine>Var OsSep As String</SourceLine>
        <SourceLine>If TargetMacOS Then</SourceLine>
        <SourceLine>OsSep = "/"</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Use the App.Atoms data as a default option</SourceLine>
        <SourceLine>Var CellString As String = AtomsListBox.CellTextAt(row, 1)</SourceLine>
        <SourceLine>Var AtomIndex As Integer = AtomsListBox.CellTagAt(row, 1).IntegerValue</SourceLine>
        <SourceLine>Var Atom As JSONItem = App.Atoms.Value(AtomIndex.ToString())</SourceLine>
        <SourceLine>Var AtomID As String = Atom.Value("ID")</SourceLine>
        <SourceLine/>
        <SourceLine>// Switch to using the on disk Atom package JSON file if it is available</SourceLine>
        <SourceLine>Var DeployAtomsFile As FolderItem = App.DeployAtomsReactorFolder.Child(AtomID + ".atom")</SourceLine>
        <SourceLine>Var DeployJSONFile As FolderItem = App.DeployJSONReactorFolder.Child(AtomID + ".json")</SourceLine>
        <SourceLine>If DeployJSONFile &lt;&gt; Nil and DeployJSONFile.Exists = True Then</SourceLine>
        <SourceLine>Var fileStream As TextInputStream = TextInputStream.Open(DeployJSONFile)</SourceLine>
        <SourceLine>If fileStream &lt;&gt; Nil Then</SourceLine>
        <SourceLine>// Read the full text file in one block</SourceLine>
        <SourceLine>Var textData As String = fileStream.ReadAll</SourceLine>
        <SourceLine>fileStream.Close</SourceLine>
        <SourceLine>// MessageBox(textData)</SourceLine>
        <SourceLine>Try</SourceLine>
        <SourceLine>Atom = New JSONItem(textData)</SourceLine>
        <SourceLine>Atom.Compact = False</SourceLine>
        <SourceLine/>
        <SourceLine>If App.InfobarEventDetails &gt;= 4 Then</SourceLine>
        <SourceLine>ConsoleWindow.Console.AddText("Removing atom package using on-disk JSON atom package file: " + DeployJSONFile.NativePath+ EndOfLine)</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Catch e As JSONException</SourceLine>
        <SourceLine>// Fallback </SourceLine>
        <SourceLine>// Display log output at medium verbosity levels</SourceLine>
        <SourceLine>If App.InfobarEventDetails &gt;= 2 Then</SourceLine>
        <SourceLine>DownloadStatsLabel.Text = e.Message</SourceLine>
        <SourceLine>ConsoleWindow.Console.AddText(ReactorWindow.DownloadStatsLabel.Text + EndOfLine)</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Catch e As UnsupportedOperationException</SourceLine>
        <SourceLine>// Fallback </SourceLine>
        <SourceLine>// Display log output at medium verbosity levels</SourceLine>
        <SourceLine>If App.InfobarEventDetails &gt;= 2 Then</SourceLine>
        <SourceLine>DownloadStatsLabel.Text = e.Message</SourceLine>
        <SourceLine>ConsoleWindow.Console.AddText(ReactorWindow.DownloadStatsLabel.Text + EndOfLine)</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>End Try</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>Var InstallState As Boolean = AtomInstalled(AtomID)</SourceLine>
        <SourceLine>If InstallState = True Then</SourceLine>
        <SourceLine>Var AtomDeploy As JSONItem = Atom.Value("Deploy")</SourceLine>
        <SourceLine>Var ZipFileURL As String =  Atom.Value("Zipfile")</SourceLine>
        <SourceLine>Var AtomzFile As FolderItem = App.AtomzFolder.Child(AtomID + ".zip")</SourceLine>
        <SourceLine/>
        <SourceLine>AtomsListBox.CellTextAt(row, 6) = "Removing"</SourceLine>
        <SourceLine>For c As Integer = 0 to AtomsListBox.ColumnCount - 1</SourceLine>
        <SourceLine>AtomsListBox.RefreshCell(row, c)</SourceLine>
        <SourceLine>Next</SourceLine>
        <SourceLine/>
        <SourceLine>// Remove the partial file</SourceLine>
        <SourceLine>If AtomzFile &lt;&gt; Nil And AtomzFile.Exists then</SourceLine>
        <SourceLine>AtomzFile.Remove()</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Deploy files</SourceLine>
        <SourceLine>Try</SourceLine>
        <SourceLine>If AtomDeploy.Keys &lt;&gt; Nil Then</SourceLine>
        <SourceLine>For Each k As String In AtomDeploy.Keys</SourceLine>
        <SourceLine>if k &lt;&gt; "Mac" and k &lt;&gt; "Windows" and k &lt;&gt; "Linux" Then</SourceLine>
        <SourceLine>// Common Files</SourceLine>
        <SourceLine>Var DeployVariant As Variant = AtomDeploy.Value(k)</SourceLine>
        <SourceLine>Var DeployFileDest As FolderItem = New FolderItem(App.DeployFolder.NativePath + OsSep + DeployVariant.StringValue)</SourceLine>
        <SourceLine/>
        <SourceLine>If DeployFileDest.Exists Then</SourceLine>
        <SourceLine>Try</SourceLine>
        <SourceLine>// Remove any legacy pre-existing files with the same filename</SourceLine>
        <SourceLine>DeployFileDest.Remove()</SourceLine>
        <SourceLine>Catch error As IOException</SourceLine>
        <SourceLine>// Display log output at medium verbosity levels</SourceLine>
        <SourceLine>If App.InfobarEventDetails &gt;= 2 Then</SourceLine>
        <SourceLine>// MessageBox(error.Message)</SourceLine>
        <SourceLine>DownloadStatsLabel.Text = error.Message</SourceLine>
        <SourceLine>ConsoleWindow.Console.AddText(ReactorWindow.DownloadStatsLabel.Text + EndOfLine)</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Catch error As UnsupportedFormatException</SourceLine>
        <SourceLine>// Display log output at medium verbosity levels</SourceLine>
        <SourceLine>If App.InfobarEventDetails &gt;= 2 Then</SourceLine>
        <SourceLine>// MessageBox(error.Message + " - " + App.DownloadFolderItem.NativePath)</SourceLine>
        <SourceLine>DownloadStatsLabel.Text = error.Message + " - " + App.DownloadFolderItem.NativePath</SourceLine>
        <SourceLine>ConsoleWindow.Console.AddText(ReactorWindow.DownloadStatsLabel.Text + EndOfLine)</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>End Try</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>ElseIf k = "Mac" and TargetMacOS Then</SourceLine>
        <SourceLine>// macOS Files</SourceLine>
        <SourceLine>Var AtomDeployOS As JSONItem = AtomDeploy.Value(k)</SourceLine>
        <SourceLine>If AtomDeployOS.Keys &lt;&gt; Nil Then</SourceLine>
