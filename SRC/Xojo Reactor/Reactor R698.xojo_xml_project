      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub RefreshDevices()</SourceLine>
        <SourceLine>// Rebuild the DevicePopupMenu content</SourceLine>
        <SourceLine>If App.GamepadSupport = 0 Then</SourceLine>
        <SourceLine>InputDeviceWindow.Title = "Input Devices - USB and Bluetooth Gamepad Support Disabled"</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>Try</SourceLine>
        <SourceLine>DevicePopupMenu.RemoveAllRows()</SourceLine>
        <SourceLine>Var mManager As GameInputManager = New GameInputManager</SourceLine>
        <SourceLine>Var device As GameInputDevice</SourceLine>
        <SourceLine>Var gCount As Integer = mManager.DeviceCount</SourceLine>
        <SourceLine>Var deviceID As Integer = 0</SourceLine>
        <SourceLine>Var deviceName As String = ""</SourceLine>
        <SourceLine>Var i as Integer = 0</SourceLine>
        <SourceLine>For deviceID = 0 To gCount - 1</SourceLine>
        <SourceLine>device = mManager.Device(deviceID)</SourceLine>
        <SourceLine>If mManager.Device(deviceID) &lt;&gt; Nil Then</SourceLine>
        <SourceLine>deviceName = mManager.Device(deviceID).Name</SourceLine>
        <SourceLine>If deviceName &lt;&gt; "" Then</SourceLine>
        <SourceLine>DevicePopupMenu.AddRow(deviceName)</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Next</SourceLine>
        <SourceLine>Catch error As RuntimeException</SourceLine>
        <SourceLine>System.DebugLog("Warning... USB Down"  + EndOfLine + EndOfLine + error.Message)</SourceLine>
        <SourceLine>End Try</SourceLine>
        <SourceLine/>
        <SourceLine>// Auto select a Sony DualSense device</SourceLine>
        <SourceLine>If DevicePopupMenu.RowCount &gt;= 1 Then</SourceLine>
        <SourceLine>DevicePopupMenu.SelectedRowIndex = DevicePopupMenu.LastRowIndex</SourceLine>
        <SourceLine>// DevicePopupMenu.SelectRowWithText("DualSense Wireless Controller")</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Enable input scanning on window open</SourceLine>
        <SourceLine>USBDevicesTimer.RunMode = Timer.RunModes.Multiple</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine/>
        <SourceLine>End Sub</SourceLine>
      </ItemSource>
