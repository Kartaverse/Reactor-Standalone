      <HookInstance>
        <ItemName>CellPressed</ItemName>
        <Compatibility/>
        <Visible>1</Visible>
        <PartID>316995583</PartID>
        <ItemSource>
          <TextEncoding>134217984</TextEncoding>
          <SourceLine>Function CellPressed(row As Integer, column As Integer, x As Integer, y As Integer) As Boolean</SourceLine>
          <SourceLine>If me.RowCount &gt;= 1 Then</SourceLine>
          <SourceLine>Var AtomIndex As Integer = Me.CellTagAt(row, 1).IntegerValue</SourceLine>
          <SourceLine>Var Atom As JSONItem = App.Atoms.Value(AtomIndex.ToString())</SourceLine>
          <SourceLine>If Atom &lt;&gt; Nil Then</SourceLine>
          <SourceLine>Var AtomID As String = Atom.Value("ID")</SourceLine>
          <SourceLine/>
          <SourceLine>If row &gt;= 0 And column &gt;= 1 Then</SourceLine>
          <SourceLine>Var CellString As String = Me.CellTextAt(row, 1)</SourceLine>
          <SourceLine>Var SelectedAtom As String = AtomID</SourceLine>
          <SourceLine>Var AtomDescription As String =  Atom.Value("Description")</SourceLine>
          <SourceLine>System.DebugLog("[Atom Description] " + SelectedAtom)</SourceLine>
          <SourceLine/>
          <SourceLine>Var HTML As String = App.Header + AtomDescription + HTMLDonation(Atom) +  HTMLDependencies(Atom) + HTMLDeployFilesList(Atom) + App.Footer</SourceLine>
          <SourceLine>//HTML = HTML.ReplaceAll("Reactor:", App.ReactorFolder.Child("Deploy").NativePath)</SourceLine>
          <SourceLine>Var DeployHTMLFile As FolderItem = App.ReactorFolder.Child("Deploy").TemporaryFile.Child("index.html")</SourceLine>
          <SourceLine/>
          <SourceLine>DescriptionHTMLViewer.LoadPage(HTML, DeployHTMLFile)</SourceLine>
          <SourceLine>End</SourceLine>
          <SourceLine/>
          <SourceLine>// The install checkbox column was clicked on</SourceLine>
          <SourceLine>If row &gt;= 0 and column = 0 Then</SourceLine>
          <SourceLine>// Push the input focus to the atom description views</SourceLine>
          <SourceLine>DescriptionHTMLViewer.SetFocus()</SourceLine>
          <SourceLine/>
          <SourceLine>// Is the atom installed already</SourceLine>
          <SourceLine>Var InstallState As Boolean = AtomInstalled(AtomID)</SourceLine>
          <SourceLine/>
          <SourceLine>// Verify no active downloads are in progress</SourceLine>
          <SourceLine>If InstallState = False Then</SourceLine>
          <SourceLine>AtomsListBox.CellTagAt(row, 0) = "Queued"</SourceLine>
          <SourceLine>For c As Integer = 0 to AtomsListBox.ColumnCount - 1</SourceLine>
          <SourceLine>AtomsListBox.RefreshCell(row, c)</SourceLine>
          <SourceLine>Next</SourceLine>
          <SourceLine>AtomDownloadQueue(AtomID, Atom)</SourceLine>
          <SourceLine>ElseIf InstallState = True Then</SourceLine>
          <SourceLine>AtomsListBox.CellTagAt(row, 0) = "Not Installed"</SourceLine>
          <SourceLine>For c As Integer = 0 to AtomsListBox.ColumnCount - 1</SourceLine>
          <SourceLine>AtomsListBox.RefreshCell(row, c)</SourceLine>
          <SourceLine>Next</SourceLine>
          <SourceLine>AtomRemoveByAtomID(AtomID)</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>// Checkbox Cell</SourceLine>
          <SourceLine>AtomsListBox.RefreshCell(row, 0)</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>End Function</SourceLine>
        </ItemSource>
      </HookInstance>
      <HookInstance>
        <ItemName>PaintCellText</ItemName>
        <Compatibility/>
        <Visible>1</Visible>
        <PartID>1413482495</PartID>
        <ItemSource>
          <TextEncoding>134217984</TextEncoding>
          <SourceLine>Function PaintCellText(g as Graphics, row as Integer, column as Integer, x as Integer, y as Integer) As Boolean</SourceLine>
          <SourceLine>// JustCropIt Custom Checkbox</SourceLine>
          <SourceLine>If column = 0 Then</SourceLine>
          <SourceLine>Var iconY as Integer = (g.Height - CheckboxOn.Height) / 2</SourceLine>
          <SourceLine>If Me.CellTagAt(row, 0) = "Installed" Then</SourceLine>
          <SourceLine>// Installed</SourceLine>
          <SourceLine>g.DrawPicture(CheckboxOn, 0, iconY)</SourceLine>
          <SourceLine>ElseIf Me.CellTagAt(row, 0) = "Not Installed" Then</SourceLine>
          <SourceLine>// Uninstalled</SourceLine>
          <SourceLine>g.DrawPicture(CheckboxOff, 0, iconY)</SourceLine>
          <SourceLine>ElseIf Me.CellTagAt(row, 0) = "Queued" Then</SourceLine>
          <SourceLine>// Queued Animated</SourceLine>
          <SourceLine>Var InProgressCount As Integer = 9</SourceLine>
          <SourceLine>Var frame As Integer = InProgressCheckboxFrame</SourceLine>
          <SourceLine>g.DrawPicture(InProgress(frame Mod InProgressCount), 0, iconY)</SourceLine>
          <SourceLine>ElseIf Me.CellTagAt(row, 0) = "Downloading" Then</SourceLine>
          <SourceLine>// Downloading Animated</SourceLine>
          <SourceLine>Var DownloadingCount As Integer = 19</SourceLine>
          <SourceLine>Var frame As Integer = DownloadingCheckboxFrame</SourceLine>
          <SourceLine>g.DrawPicture(Downloading(frame Mod DownloadingCount), 0, iconY)</SourceLine>
          <SourceLine>Else</SourceLine>
          <SourceLine>// Fallback to unchecked</SourceLine>
          <SourceLine>g.DrawPicture(CheckboxOff, 0, iconY)</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>If Me.RowSelectedAt(row) Then</SourceLine>
          <SourceLine>// Is a selected row</SourceLine>
          <SourceLine>// JustCropIt White Text</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(254, 254, 254)</SourceLine>
          <SourceLine>Else</SourceLine>
          <SourceLine>// Not a selected row</SourceLine>
          <SourceLine>Select Case Me.RowTagAt(row)</SourceLine>
          <SourceLine>Case "Not Installed"</SourceLine>
          <SourceLine>// JustCropIt Medium Grey Text</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(151, 151, 151)</SourceLine>
          <SourceLine>Case "Installed"</SourceLine>
          <SourceLine>// JustCropIt Medium Grey Text</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(151, 151, 151)</SourceLine>
          <SourceLine>Case "Downloading"</SourceLine>
          <SourceLine>// JustCropIt Cyan</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(119, 227, 252)</SourceLine>
          <SourceLine>Case "Queued"</SourceLine>
          <SourceLine>// JustCropIt Cyan</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(119, 227, 252)</SourceLine>
          <SourceLine>Case "Update"</SourceLine>
          <SourceLine>// JustCropIt Purple</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(193,135, 248)</SourceLine>
          <SourceLine>Case "New"</SourceLine>
          <SourceLine>// JustCropIt Neon Green</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(154, 233, 60)</SourceLine>
          <SourceLine>Case "Incompatible"</SourceLine>
          <SourceLine>// JustCropIt Neon Pink</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(251, 60, 107)</SourceLine>
          <SourceLine>Else</SourceLine>
          <SourceLine>// JustCropIt Medium Grey Text</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(151, 151, 151)</SourceLine>
          <SourceLine>End Select</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>End Function</SourceLine>
        </ItemSource>
      </HookInstance>
      <HookInstance>
        <ItemName>PaintCellBackground</ItemName>
        <Compatibility/>
        <Visible>1</Visible>
        <PartID>1801525247</PartID>
        <ItemSource>
          <TextEncoding>134217984</TextEncoding>
          <SourceLine>Function PaintCellBackground(g As Graphics, row As Integer, column As Integer) As Boolean</SourceLine>
          <SourceLine>// Clean out any previous cell content - Solves transparent icon drawing artifacts</SourceLine>
          <SourceLine>g.ClearRectangle(0, 0, g.Width, g.Height)</SourceLine>
          <SourceLine/>
          <SourceLine>// Draw the listbox row shading for unselected rows</SourceLine>
          <SourceLine>If row Mod 2 = 0 Then</SourceLine>
          <SourceLine>// Secondary Row Shading Colour</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(34, 34, 34)</SourceLine>
          <SourceLine>Else</SourceLine>
          <SourceLine>// Primary Row Shading Colour</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(41, 41, 41)</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>If row &gt;= 0 And row &lt;= Me.LastRowIndex Then</SourceLine>
          <SourceLine>If Me.RowSelectedAt(row) Then</SourceLine>
          <SourceLine>Select Case Me.RowTagAt(row)</SourceLine>
          <SourceLine>Case "Not Installed"</SourceLine>
          <SourceLine>// JustCropIt Medium Grey BG</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(126, 126, 126)</SourceLine>
          <SourceLine>Case "Installed"</SourceLine>
          <SourceLine>// JustCropIt Medium Grey BG</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(126, 126, 126)</SourceLine>
          <SourceLine>Case "Downloading"</SourceLine>
          <SourceLine>// JustCropIt Cyan BG</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(84, 149, 169)</SourceLine>
          <SourceLine>Case "Queued"</SourceLine>
          <SourceLine>// JustCropIt Cyan BG</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(84, 149, 169)</SourceLine>
          <SourceLine>Case "Update"</SourceLine>
          <SourceLine>// JustCropIt Purple BG</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(132,94, 166)</SourceLine>
          <SourceLine>Case "New"</SourceLine>
          <SourceLine>// JustCropIt Neon Green BG</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(132, 162, 79)</SourceLine>
          <SourceLine>Case "Incompatible"</SourceLine>
          <SourceLine>// JustCropIt Neon Pink BG</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(127, 52, 71)</SourceLine>
          <SourceLine>Else</SourceLine>
          <SourceLine>// // JustCropIt Medium Grey BG</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(126, 126, 126)</SourceLine>
          <SourceLine>End Select</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>g.FillRectangle(0, 0, g.Width, g.Height)</SourceLine>
          <SourceLine/>
          <SourceLine>Return True</SourceLine>
          <SourceLine/>
          <SourceLine/>
          <SourceLine>End Function</SourceLine>
        </ItemSource>
      </HookInstance>
      <HookInstance>
        <ItemName>PaintHeaderContent</ItemName>
        <Compatibility/>
        <Visible>1</Visible>
        <PartID>1111216127</PartID>
        <ItemSource>
          <TextEncoding>134217984</TextEncoding>
          <SourceLine>Function PaintHeaderContent(g As Graphics, column As Integer) As Boolean</SourceLine>
          <SourceLine>// JustCropIt ListBox Header Grey BG</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(42, 42, 42)</SourceLine>
          <SourceLine>g.FillRectangle(0, 0, g.Width, g.Height)</SourceLine>
          <SourceLine/>
          <SourceLine>// JustCropIt Dark Grey Outline Stroke</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(21, 21, 21)</SourceLine>
          <SourceLine>g.DrawLine(g.Width - 1, 0, g.Width - 1, g.Height)</SourceLine>
          <SourceLine/>
          <SourceLine>// Column selection bold highlight</SourceLine>
          <SourceLine>If Me.HeadingIndex = column Then</SourceLine>
