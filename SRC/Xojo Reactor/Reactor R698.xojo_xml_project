    <Method>
      <ItemName>RefreshStateCount</ItemName>
      <Compatibility/>
      <Visible>1</Visible>
      <PartID>2080360447</PartID>
      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub RefreshStateCount()</SourceLine>
        <SourceLine>// Update the number next to the state rows</SourceLine>
        <SourceLine/>
        <SourceLine>// Create a new JSON object hierarchy</SourceLine>
        <SourceLine>App.JSONStateCount = New JSONItem()</SourceLine>
        <SourceLine>App.JSONStateCount.Compact = False</SourceLine>
        <SourceLine/>
        <SourceLine>Var InstalledCount As Integer = 0</SourceLine>
        <SourceLine>Var UninstalledCount As Integer = 0</SourceLine>
        <SourceLine>Var DependenciesCount As Integer = 0</SourceLine>
        <SourceLine>Var DonationsCount As Integer = 0</SourceLine>
        <SourceLine>Var IncompatibleCount As Integer = 0</SourceLine>
        <SourceLine>Var NewCount As Integer = 0</SourceLine>
        <SourceLine>Var UpdateCount As Integer = 0</SourceLine>
        <SourceLine>Var DownloadingCount As Integer = 0</SourceLine>
        <SourceLine/>
        <SourceLine>If App.Atoms &lt;&gt; Nil Then</SourceLine>
        <SourceLine>Var AtomCount As Integer = App.Atoms.Keys.Count</SourceLine>
        <SourceLine>DependenciesCount = App.DependencyList.Count</SourceLine>
        <SourceLine>For Each k As String In App.Atoms.Keys</SourceLine>
        <SourceLine>Var Atom As JSONItem = App.Atoms.Value(k)</SourceLine>
        <SourceLine>Var AtomID As String =  Atom.Value("ID")</SourceLine>
        <SourceLine>Var InstallState As Boolean = AtomInstalled(AtomID)</SourceLine>
        <SourceLine>If InstallState = True Then</SourceLine>
        <SourceLine>InstalledCount = InstalledCount + 1</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>UninstalledCount = UninstalledCount + 1</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>If App.DownloadAtomID = AtomID Then</SourceLine>
        <SourceLine>DownloadingCount = DownloadingCount + 1</SourceLine>
        <SourceLine>ElseIf App.DownloadList.IndexOf(AtomID) &lt;&gt; -1 and InstallState = False Then</SourceLine>
        <SourceLine>DownloadingCount = DownloadingCount + 1</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>If InstallState = True and Atom.HasKey("Donation") Then</SourceLine>
        <SourceLine>DonationsCount = DonationsCount + 1</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Var AtomDisabled As Boolean = AtomIncompatible(AtomID)</SourceLine>
        <SourceLine>If AtomDisabled = True Then</SourceLine>
        <SourceLine>IncompatibleCount = IncompatibleCount + 1</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>// Calculate if the atom is "New" </SourceLine>
        <SourceLine>Var AtomDateJSON As JSONItem = Atom.Value("Date")</SourceLine>
        <SourceLine>Var AtomDateYear As Double = AtomDateJSON.Value("1.0")</SourceLine>
        <SourceLine>Var AtomDateMonth As Double = AtomDateJSON.Value("2.0")</SourceLine>
        <SourceLine>Var AtomDateDay As Double = AtomDateJSON.Value("3.0")</SourceLine>
        <SourceLine>Var AtomDateTime As New DateTime(AtomDateYear, AtomDateMonth, AtomDateDay)</SourceLine>
        <SourceLine>Var NowDateTime As DateTime = DateTime.Now</SourceLine>
        <SourceLine>// How many days ago was the atom posted in Reactor?</SourceLine>
        <SourceLine>Var DaysElapsed As Integer = (NowDateTime.SecondsFrom1970 - AtomDateTime.SecondsFrom1970) / (24 * 60 * 60)</SourceLine>
        <SourceLine>If App.MarkAsNew = True and App.NewForDays &gt;= DaysElapsed Then</SourceLine>
        <SourceLine>NewCount = NewCount + 1</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Var AtomUpdated As Boolean = AtomUpdateAvailable(AtomID)</SourceLine>
        <SourceLine>If AtomUpdated = True Then</SourceLine>
        <SourceLine>UpdateCount = UpdateCount + 1</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Next</SourceLine>
        <SourceLine/>
        <SourceLine>App.JSONStateCount.Value("Any State") = AtomCount - IncompatibleCount</SourceLine>
        <SourceLine>App.JSONStateCount.Value("Installed") = InstalledCount</SourceLine>
        <SourceLine>App.JSONStateCount.Value("Not Installed") = UninstalledCount - IncompatibleCount</SourceLine>
        <SourceLine>App.JSONStateCount.Value("Dependencies") = DependenciesCount</SourceLine>
        <SourceLine>App.JSONStateCount.Value("Donate") = DonationsCount</SourceLine>
        <SourceLine>App.JSONStateCount.Value("Incompatible") = IncompatibleCount</SourceLine>
        <SourceLine>App.JSONStateCount.Value("New") = NewCount</SourceLine>
        <SourceLine>App.JSONStateCount.Value("Update") = UpdateCount</SourceLine>
        <SourceLine>App.JSONStateCount.Value("Downloading") = DownloadingCount</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Refresh the cell contents to update the number count</SourceLine>
        <SourceLine>For row As Integer = StateListBox.RowCount -1 DownTo 0</SourceLine>
        <SourceLine>StateListBox.RefreshCell(row, 0)</SourceLine>
        <SourceLine>Next</SourceLine>
        <SourceLine/>
        <SourceLine/>
        <SourceLine>End Sub</SourceLine>
      </ItemSource>
      <TextEncoding>134217984</TextEncoding>
      <AliasName/>
      <ItemFlags>0</ItemFlags>
      <IsShared>0</IsShared>
      <ItemParams/>
      <ItemResult/>
    </Method>
    <Method>
      <ItemName>RefreshCategoryCount</ItemName>
      <Compatibility/>
      <Visible>1</Visible>
      <PartID>394299391</PartID>
      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub RefreshCategoryCount()</SourceLine>
        <SourceLine>// Update the number next to the category rows</SourceLine>
        <SourceLine>Var row As Integer</SourceLine>
        <SourceLine/>
        <SourceLine>Var StateRow As Integer = StateListBox.SelectedRowIndex</SourceLine>
        <SourceLine>If StateRow &gt;= 0 Then</SourceLine>
        <SourceLine>Var SelectedState As String = StateListBox.CellTextAt(StateRow, 0)</SourceLine>
        <SourceLine/>
        <SourceLine>Var IncompatibleCount As Integer = 0</SourceLine>
        <SourceLine/>
        <SourceLine>// Create a new JSON object hierarchy</SourceLine>
        <SourceLine>App.JSONCategoryCount = New JSONItem()</SourceLine>
        <SourceLine>App.JSONCategoryCount.Compact = False</SourceLine>
        <SourceLine/>
        <SourceLine>If App.Atoms &lt;&gt; Nil Then</SourceLine>
        <SourceLine>For Each k As String In App.Atoms.Keys</SourceLine>
        <SourceLine>Var Atom As JSONItem = App.Atoms.Value(k)</SourceLine>
        <SourceLine>Var AtomID As String =  Atom.Value("ID")</SourceLine>
        <SourceLine>Var AtomCategory As String = Atom.Value("Category")</SourceLine>
        <SourceLine>Var AtomCategoryArray() As String</SourceLine>
        <SourceLine>AtomCategoryArray = AtomCategory.Split("/")</SourceLine>
        <SourceLine>Var InstallState As Boolean = AtomInstalled(AtomID)</SourceLine>
        <SourceLine/>
        <SourceLine>Var AtomDisabled As Boolean = AtomIncompatible(AtomID)</SourceLine>
        <SourceLine>If AtomDisabled = True Then</SourceLine>
        <SourceLine>IncompatibleCount = IncompatibleCount + 1</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Create a stub entry with an initial value</SourceLine>
        <SourceLine>If App.JSONCategoryCount.HasKey(AtomCategoryArray(0)) = False Then</SourceLine>
        <SourceLine>// There is no pre-existing entry for this category key</SourceLine>
        <SourceLine>App.JSONCategoryCount.Value(AtomCategoryArray(0)) = 0</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>If App.JSONCategoryCount.HasKey(AtomCategoryArray(0)) = True Then</SourceLine>
        <SourceLine>// Add another value to this category key </SourceLine>
        <SourceLine>Select Case SelectedState</SourceLine>
        <SourceLine>Case "Any State"</SourceLine>
        <SourceLine>App.JSONCategoryCount.Value(AtomCategoryArray(0)) = App.JSONCategoryCount.Value(AtomCategoryArray(0)) + 1</SourceLine>
        <SourceLine>Case "Installed"</SourceLine>
        <SourceLine>If InstallState = True Then</SourceLine>
        <SourceLine>App.JSONCategoryCount.Value(AtomCategoryArray(0)) = App.JSONCategoryCount.Value(AtomCategoryArray(0)) + 1</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Case "Not Installed"</SourceLine>
        <SourceLine>If InstallState = False Then</SourceLine>
        <SourceLine>App.JSONCategoryCount.Value(AtomCategoryArray(0)) = App.JSONCategoryCount.Value(AtomCategoryArray(0)) + 1</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Case "Dependencies"</SourceLine>
        <SourceLine>If App.DependencyList.IndexOf(AtomID) &gt;= 0 Then</SourceLine>
        <SourceLine>App.JSONCategoryCount.Value(AtomCategoryArray(0)) = App.JSONCategoryCount.Value(AtomCategoryArray(0)) + 1</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Case "Donate"</SourceLine>
        <SourceLine>If InstallState = True and Atom.HasKey("Donation") Then</SourceLine>
        <SourceLine>App.JSONCategoryCount.Value(AtomCategoryArray(0)) = App.JSONCategoryCount.Value(AtomCategoryArray(0)) + 1</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Case "Incompatible"</SourceLine>
        <SourceLine>If AtomDisabled = True Then</SourceLine>
        <SourceLine>App.JSONCategoryCount.Value(AtomCategoryArray(0)) = App.JSONCategoryCount.Value(AtomCategoryArray(0)) + 1</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Case "New"</SourceLine>
        <SourceLine>// Calculate if the atom is "New" </SourceLine>
        <SourceLine>Var AtomDateJSON As JSONItem = Atom.Value("Date")</SourceLine>
        <SourceLine>Var AtomDateYear As Double = AtomDateJSON.Value("1.0")</SourceLine>
        <SourceLine>Var AtomDateMonth As Double = AtomDateJSON.Value("2.0")</SourceLine>
        <SourceLine>Var AtomDateDay As Double = AtomDateJSON.Value("3.0")</SourceLine>
        <SourceLine>Var AtomDateTime As New DateTime(AtomDateYear, AtomDateMonth, AtomDateDay)</SourceLine>
        <SourceLine>Var NowDateTime As DateTime = DateTime.Now</SourceLine>
        <SourceLine>// How many days ago was the atom posted in Reactor?</SourceLine>
        <SourceLine>Var DaysElapsed As Integer = (NowDateTime.SecondsFrom1970 - AtomDateTime.SecondsFrom1970) / (24 * 60 * 60)</SourceLine>
        <SourceLine>If App.MarkAsNew = True and App.NewForDays &gt;= DaysElapsed Then</SourceLine>
        <SourceLine>App.JSONCategoryCount.Value(AtomCategoryArray(0)) = App.JSONCategoryCount.Value(AtomCategoryArray(0)) + 1</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Case "Update"</SourceLine>
        <SourceLine>Var AtomUpdated As Boolean = AtomUpdateAvailable(AtomID)</SourceLine>
        <SourceLine>If AtomUpdated = True Then</SourceLine>
        <SourceLine>App.JSONCategoryCount.Value(AtomCategoryArray(0)) = App.JSONCategoryCount.Value(AtomCategoryArray(0)) + 1</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Case "Downloading"</SourceLine>
        <SourceLine>If App.DownloadAtomID = AtomID Then</SourceLine>
        <SourceLine>App.JSONCategoryCount.Value(AtomCategoryArray(0)) = App.JSONCategoryCount.Value(AtomCategoryArray(0)) + 1</SourceLine>
        <SourceLine>ElseIf App.DownloadList.IndexOf(AtomID) &lt;&gt; -1 and InstallState = False Then</SourceLine>
        <SourceLine>App.JSONCategoryCount.Value(AtomCategoryArray(0)) = App.JSONCategoryCount.Value(AtomCategoryArray(0)) + 1</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>End Select</SourceLine>
        <SourceLine>End if</SourceLine>
        <SourceLine>Next</SourceLine>
        <SourceLine/>
        <SourceLine>// Var AtomCount As Integer = App.Atoms.Keys.Count</SourceLine>
        <SourceLine>// App.JSONCategoryCount.Value("Any Category") = AtomCount - IncompatibleCount</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>//System.DebugLog(App.JSONCategoryCount.ToString())</SourceLine>
        <SourceLine/>
        <SourceLine>// Refresh the cell contents to update the number count</SourceLine>
        <SourceLine>For row = CategoryListBox.RowCount -1 DownTo 0</SourceLine>
        <SourceLine>CategoryListBox.RefreshCell(row, 0)</SourceLine>
        <SourceLine>Next</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>End Sub</SourceLine>
      </ItemSource>
      <TextEncoding>134217984</TextEncoding>
      <AliasName/>
      <ItemFlags>0</ItemFlags>
      <IsShared>0</IsShared>
      <ItemParams/>
      <ItemResult/>
    </Method>
    <Method>
      <ItemName>RefreshHighlights</ItemName>
      <Compatibility/>
      <Visible>1</Visible>
      <PartID>618027007</PartID>
      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub RefreshHighlights(Index As Integer)</SourceLine>
        <SourceLine>// Display log output at high verbosity levels</SourceLine>
        <SourceLine>If App.InfobarEventDetails &gt;= 3 Then</SourceLine>
        <SourceLine>System.DebugLog("[Highlights] " + App.Highlights.Count.ToString)</SourceLine>
        <SourceLine>System.DebugLog(App.Highlights.ToString())</SourceLine>
        <SourceLine/>
        <SourceLine>ConsoleWindow.Console.AddText("[Highlights] " + App.Highlights.Count.ToString + EndOfLine)</SourceLine>
        <SourceLine>ConsoleWindow.Console.AddText(App.Highlights.ToString() + EndOfLine)</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Clamp to active range</SourceLine>
        <SourceLine>Var i As Integer = Index</SourceLine>
        <SourceLine>if i &gt; App.Highlights.Count Then</SourceLine>
        <SourceLine>// Clamp the high bounds</SourceLine>
        <SourceLine>i = App.Highlights.Count</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Track the active Highlights page</SourceLine>
        <SourceLine>App.HighlightsIndex = i</SourceLine>
        <SourceLine/>
        <SourceLine>// Toggle the bullet icon visibility</SourceLine>
        <SourceLine>If App.Highlights.Count = 0 Then</SourceLine>
        <SourceLine>HighlightTopBulletCanvas1.Visible = False</SourceLine>
        <SourceLine>HighlightTopBulletCanvas2.Visible = False</SourceLine>
        <SourceLine>HighlightTopBulletCanvas3.Visible = False</SourceLine>
        <SourceLine>HighlightTopBulletCanvas4.Visible = False</SourceLine>
        <SourceLine>ElseIf App.Highlights.Count = 1 Then</SourceLine>
        <SourceLine>HighlightTopBulletCanvas1.Visible = True</SourceLine>
        <SourceLine>HighlightTopBulletCanvas2.Visible = False</SourceLine>
        <SourceLine>HighlightTopBulletCanvas3.Visible = False</SourceLine>
        <SourceLine>HighlightTopBulletCanvas4.Visible = False</SourceLine>
        <SourceLine>ElseIf App.Highlights.Count = 2 Then</SourceLine>
        <SourceLine>HighlightTopBulletCanvas1.Visible = True</SourceLine>
        <SourceLine>HighlightTopBulletCanvas2.Visible = True</SourceLine>
        <SourceLine>HighlightTopBulletCanvas3.Visible = False</SourceLine>
        <SourceLine>HighlightTopBulletCanvas4.Visible = False</SourceLine>
        <SourceLine>ElseIf App.Highlights.Count = 3 Then</SourceLine>
        <SourceLine>HighlightTopBulletCanvas1.Visible = True</SourceLine>
        <SourceLine>HighlightTopBulletCanvas2.Visible = True</SourceLine>
        <SourceLine>HighlightTopBulletCanvas3.Visible = True</SourceLine>
        <SourceLine>HighlightTopBulletCanvas4.Visible = False</SourceLine>
        <SourceLine>ElseIf App.Highlights.Count = 4 Then</SourceLine>
        <SourceLine>HighlightTopBulletCanvas1.Visible = True</SourceLine>
        <SourceLine>HighlightTopBulletCanvas2.Visible = True</SourceLine>
        <SourceLine>HighlightTopBulletCanvas3.Visible = True</SourceLine>
        <SourceLine>HighlightTopBulletCanvas4.Visible = True</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Toggle the bullet icon state</SourceLine>
        <SourceLine>If i = 1 Then</SourceLine>
        <SourceLine>HighlightTopBulletCanvas1.Backdrop = PromoBulletOn</SourceLine>
        <SourceLine>HighlightTopBulletCanvas2.Backdrop = PromoBulletOff</SourceLine>
        <SourceLine>HighlightTopBulletCanvas3.Backdrop = PromoBulletOff</SourceLine>
        <SourceLine>HighlightTopBulletCanvas4.Backdrop = PromoBulletOff</SourceLine>
        <SourceLine>ElseIf i = 2 Then</SourceLine>
        <SourceLine>HighlightTopBulletCanvas1.Backdrop = PromoBulletOff</SourceLine>
        <SourceLine>HighlightTopBulletCanvas2.Backdrop = PromoBulletOn</SourceLine>
        <SourceLine>HighlightTopBulletCanvas3.Backdrop = PromoBulletOff</SourceLine>
        <SourceLine>HighlightTopBulletCanvas4.Backdrop = PromoBulletOff</SourceLine>
        <SourceLine>ElseIf i = 3 Then</SourceLine>
        <SourceLine>HighlightTopBulletCanvas1.Backdrop = PromoBulletOff</SourceLine>
        <SourceLine>HighlightTopBulletCanvas2.Backdrop = PromoBulletOff</SourceLine>
        <SourceLine>HighlightTopBulletCanvas3.Backdrop = PromoBulletOn</SourceLine>
        <SourceLine>HighlightTopBulletCanvas4.Backdrop = PromoBulletOff</SourceLine>
        <SourceLine>ElseIf i = 4 Then</SourceLine>
