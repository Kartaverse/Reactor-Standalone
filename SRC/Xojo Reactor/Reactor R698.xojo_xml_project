          <SourceLine>// Update the downloading status line</SourceLine>
          <SourceLine>For RefreshRow As Integer = 0 to AtomsListBox.RowCount - 1</SourceLine>
          <SourceLine>If AtomsListBox.CellTextAt(RefreshRow, 1) = App.DownloadName Then</SourceLine>
          <SourceLine>Var StateRow As Integer = StateListBox.SelectedRowIndex</SourceLine>
