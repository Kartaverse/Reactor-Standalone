        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub Opening()</SourceLine>
        <SourceLine>App.AllowAutoQuit = True</SourceLine>
        <SourceLine/>
        <SourceLine>// Force the light mode setting</SourceLine>
        <SourceLine>// System.EnvironmentVariable("XOJO_WIN32_DARKMODE_DISABLED") = "True"</SourceLine>
        <SourceLine/>
        <SourceLine>// Default Repo for Reactor to use with Resolve/Fusion</SourceLine>
        <SourceLine>App.AtomsRepo = "_Core"</SourceLine>
        <SourceLine/>
        <SourceLine>// Load JSON Preferences</SourceLine>
        <SourceLine>LoadSettings()</SourceLine>
        <SourceLine/>
        <SourceLine>// Load the JSON values as the Window position</SourceLine>
        <SourceLine>If App.Settings &lt;&gt; Nil and App.Settings.HasKey("MainWindow") Then</SourceLine>
        <SourceLine>Var jsonWindow As JSONItem = App.Settings.Value("MainWindow")</SourceLine>
        <SourceLine>Var Val As String</SourceLine>
        <SourceLine/>
        <SourceLine>If jsonWindow.HasKey("Top") Then</SourceLine>
        <SourceLine>Val = jsonWindow.Value("Top")</SourceLine>
        <SourceLine>ReactorWindow.Top = Val.ToInteger</SourceLine>
        <SourceLine>ElseIf TargetMacOS Then</SourceLine>
        <SourceLine>// Avoid running this code on WindowsOS as the ReactorWindow title bar will dock above the top row of the display</SourceLine>
        <SourceLine>ReactorWindow.Top = DesktopDisplay.DisplayAt(0).AvailableTop + 28</SourceLine>
        <SourceLine>System.DebugLog("[Settings Read] No Reactor window top coordinates found in settings file.")</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>If jsonWindow.HasKey("Left") Then</SourceLine>
        <SourceLine>Val = jsonWindow.Value("Left")</SourceLine>
        <SourceLine>ReactorWindow.Left = Val.ToInteger</SourceLine>
        <SourceLine>ElseIf TargetMacOS Then</SourceLine>
        <SourceLine>// Avoid running this code on WindowsOS as the ReactorWindow title bar will dock above the top row of the display</SourceLine>
        <SourceLine>ReactorWindow.Left = DesktopDisplay.DisplayAt(0).AvailableLeft</SourceLine>
        <SourceLine>System.DebugLog("[Settings Read] No Reactor window left coordinates found in settings file.")</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>If jsonWindow.HasKey("Width") Then</SourceLine>
        <SourceLine>Val = jsonWindow.Value("Width")</SourceLine>
        <SourceLine>ReactorWindow.Width = Val.ToInteger</SourceLine>
        <SourceLine>ElseIf TargetMacOS Then</SourceLine>
        <SourceLine>// ReactorWindow.Width = DesktopDisplay.DisplayAt(0).AvailableWidth</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>If jsonWindow.HasKey("Height") Then</SourceLine>
        <SourceLine>Val = jsonWindow.Value("Height")</SourceLine>
        <SourceLine>ReactorWindow.Height = Val.ToInteger</SourceLine>
        <SourceLine>ElseIf TargetMacOS Then</SourceLine>
        <SourceLine>// Me.Height = DesktopDisplay.DisplayAt(0).AvailableHeight - 28</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>System.DebugLog("[Settings Read] No Reactor window coordinates found in settings file.")</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Control the gamepad Input timer</SourceLine>
        <SourceLine>If App.GamepadSupport = 1 Then</SourceLine>
        <SourceLine>ReactorWindow.TimerInputDevices.Enabled = True</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>ReactorWindow.TimerInputDevices.Enabled = False</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Rebuild the Reactor folder hiearchy</SourceLine>
        <SourceLine>App.CreateReactorFolders()</SourceLine>
        <SourceLine/>
        <SourceLine>// Turn the download queue on</SourceLine>
        <SourceLine>ReactorWindow.TimerQueue.RunMode = Timer.RunModes.Multiple</SourceLine>
        <SourceLine/>
        <SourceLine>// Download the Reactor.json file</SourceLine>
        <SourceLine>ReactorWindow.JSONDownload()</SourceLine>
        <SourceLine/>
        <SourceLine>// Update the listboxes</SourceLine>
        <SourceLine>ReactorWindow.RefreshApp()</SourceLine>
        <SourceLine>ReactorWindow.RefreshState()</SourceLine>
        <SourceLine>ReactorWindow.RefreshCategory()</SourceLine>
        <SourceLine>ReactorWindow.RefreshAtoms()</SourceLine>
        <SourceLine>ReactorWindow.RefreshHighlights(1)</SourceLine>
        <SourceLine/>
        <SourceLine>// Reactor.json data processed</SourceLine>
        <SourceLine>ReactorWindow.DownloadStatsLabel.Text = ""</SourceLine>
        <SourceLine/>
        <SourceLine>ReactorWindow.ColorProgressBar.Visible = False</SourceLine>
        <SourceLine>ReactorWindow.ColorProgressBar.Refresh(False)</SourceLine>
        <SourceLine/>
        <SourceLine>ReactorWindow.ClearDownloadQueueButtonState = "Inactive"</SourceLine>
        <SourceLine/>
        <SourceLine>End Sub</SourceLine>
