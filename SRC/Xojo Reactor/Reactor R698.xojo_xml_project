        <SourceLine>// Reset the state selection to "Any State"</SourceLine>
        <SourceLine>If StateListBox.RowCount &gt;= 1 Then</SourceLine>
        <SourceLine>StateListBox.SelectedRowIndex = 0</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>End Sub</SourceLine>
