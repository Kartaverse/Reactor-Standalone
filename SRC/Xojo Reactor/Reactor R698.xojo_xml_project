      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub RefreshRepo()</SourceLine>
        <SourceLine>If RepoListBox.RowCount &gt;= 1 and RepoListBox.SelectedRowIndex &lt;&gt; -1  Then</SourceLine>
        <SourceLine>Var SelectedMode As String = RepoListBox.CellTextAt(RepoListBox.SelectedRowIndex, 0)</SourceLine>
        <SourceLine/>
        <SourceLine>// Display log output at high verbosity levels</SourceLine>
        <SourceLine>If App.InfobarEventDetails &gt;= 3 Then</SourceLine>
        <SourceLine>System.DebugLog(SelectedMode + " Repo Selected")</SourceLine>
        <SourceLine>DownloadStatsLabel.Text = SelectedMode + " Repo Selected"</SourceLine>
        <SourceLine>DownloadStatsLabel.Refresh(False)</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Switch the active repo</SourceLine>
        <SourceLine>Select Case SelectedMode</SourceLine>
        <SourceLine>case "Resolve/Fusion"</SourceLine>
        <SourceLine>App.AtomsRepo = "_Core"</SourceLine>
        <SourceLine>case "Scratch/LiveFX"</SourceLine>
        <SourceLine>App.AtomsRepo = "_Assimilate"</SourceLine>
        <SourceLine>case "Houdini"</SourceLine>
        <SourceLine>App.AtomsRepo = "_Houdini"</SourceLine>
        <SourceLine>case "JangaFX"</SourceLine>
        <SourceLine>App.AtomsRepo = "_JangaFX"</SourceLine>
        <SourceLine>case "LightWave"</SourceLine>
        <SourceLine>App.AtomsRepo = "_LW"</SourceLine>
        <SourceLine>case "OpenFX"</SourceLine>
        <SourceLine>App.AtomsRepo = "_OFX"</SourceLine>
        <SourceLine>case "Pipeline"</SourceLine>
        <SourceLine>App.AtomsRepo = "_Pipeline"</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>App.AtomsRepo = "_Core"</SourceLine>
        <SourceLine>End Select</SourceLine>
        <SourceLine/>
        <SourceLine>// Rebuild the Reactor folders</SourceLine>
        <SourceLine>App.CreateReactorFolders()</SourceLine>
        <SourceLine/>
        <SourceLine>// Cancel any active download queue items</SourceLine>
        <SourceLine>ReactorWindow.AtomDownloadCancel()</SourceLine>
        <SourceLine/>
        <SourceLine>// Refresh the Reactor.json file</SourceLine>
        <SourceLine>ReactorWindow.JSONDownload()</SourceLine>
        <SourceLine/>
        <SourceLine>// Update the number next to the state rows</SourceLine>
        <SourceLine>RefreshStateCount()</SourceLine>
        <SourceLine/>
        <SourceLine>// Rebuild the category list</SourceLine>
        <SourceLine>RefreshCategory()</SourceLine>
        <SourceLine/>
        <SourceLine>// Update the number next to the category rows</SourceLine>
        <SourceLine>RefreshCategoryCount()</SourceLine>
        <SourceLine/>
        <SourceLine>// Rebuild the atoms list</SourceLine>
        <SourceLine>RefreshAtoms()</SourceLine>
        <SourceLine/>
        <SourceLine>// Push the input focus to the atom description views</SourceLine>
        <SourceLine>DescriptionHTMLViewer.SetFocus()</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>// Update the number next to the state rows</SourceLine>
        <SourceLine>RefreshStateCount()</SourceLine>
        <SourceLine/>
        <SourceLine>// Update the number next to the category rows</SourceLine>
        <SourceLine>RefreshCategoryCount()</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Clear the old content</SourceLine>
        <SourceLine>StateListBox.RemoveAllRows()</SourceLine>
        <SourceLine/>
        <SourceLine>// Fill the listbox with content</SourceLine>
        <SourceLine>Var StateArray() As String</SourceLine>
        <SourceLine>StateArray = Array("Any State", "Installed", "Not Installed", "Dependencies", "Donate", "Incompatible", "New", "Update", "Downloading")</SourceLine>
        <SourceLine>For row As Integer = StateArray.Count -1 DownTo 0</SourceLine>
        <SourceLine>StateListBox.AddRowAt(StateListBox.LastAddedRowIndex, StateArray(row))</SourceLine>
        <SourceLine>StateListBox.CellAlignmentOffsetAt(StateListBox.LastAddedRowIndex, 0) = 10</SourceLine>
        <SourceLine>Next</SourceLine>
