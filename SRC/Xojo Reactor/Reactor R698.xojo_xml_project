        <ItemSource>
          <TextEncoding>134217984</TextEncoding>
          <SourceLine>Sub Paint(g As Graphics, areas() As Rect)</SourceLine>
          <SourceLine>// Button state property name</SourceLine>
          <SourceLine>Var State As String = SearchButtonState</SourceLine>
          <SourceLine/>
          <SourceLine>// Text String</SourceLine>
          <SourceLine>Var buttonTxt As String = "Search"</SourceLine>
          <SourceLine/>
          <SourceLine>// Text Font</SourceLine>
          <SourceLine>g.FontName = "Inter"</SourceLine>
          <SourceLine/>
          <SourceLine>// Text bold</SourceLine>
          <SourceLine>// g.Bold = True</SourceLine>
          <SourceLine/>
          <SourceLine>If State = "Up" Then</SourceLine>
          <SourceLine>// Button Left Cap</SourceLine>
          <SourceLine>//g.DrawPicture(Button_Default_Grey_Left, 0, 0)</SourceLine>
          <SourceLine>// Button Centre Stretch</SourceLine>
          <SourceLine>//g.DrawPicture(Button_Default_Grey_Middle, Button_Pressed_Grey_Left.Width, 0,  g.Width - Button_Pressed_Grey_Left.Width - Button_Pressed_Grey_Right.Width , Button_Pressed_Grey_Middle.Height, 0, 0, Button_Pressed_Grey_Middle.Width, Button_Pressed_Grey_Middle.Height)</SourceLine>
          <SourceLine>// Button Right Cap</SourceLine>
          <SourceLine>//g.DrawPicture(Button_Default_Grey_Right, g.Width - Button_Pressed_Grey_Right.Width, 0)</SourceLine>
          <SourceLine/>
          <SourceLine>g.DrawPicture(Button_Default_Yellow_Left, 0, 0)</SourceLine>
          <SourceLine>// Button Centre Stretch</SourceLine>
          <SourceLine>g.DrawPicture(Button_Default_Yellow_Middle, Button_Pressed_Yellow_Left.Width, 0,  g.Width - Button_Pressed_Yellow_Left.Width - Button_Pressed_Yellow_Right.Width , Button_Pressed_Yellow_Middle.Height, 0, 0, Button_Pressed_Yellow_Middle.Width, Button_Pressed_Yellow_Middle.Height)</SourceLine>
          <SourceLine>// Button Right Cap</SourceLine>
          <SourceLine>g.DrawPicture(Button_Default_Yellow_Right, g.Width - Button_Pressed_Yellow_Right.Width, 0)</SourceLine>
          <SourceLine/>
          <SourceLine>// Text JustCropIt Off White Color</SourceLine>
          <SourceLine>// g.DrawingColor = Color.RGB(149, 149, 149)</SourceLine>
          <SourceLine>// g.DrawingColor = Color.RGB(208, 208, 208)</SourceLine>
          <SourceLine/>
          <SourceLine>// Text Black</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(19, 19, 19)</SourceLine>
          <SourceLine>ElseIf State = "Down" Then</SourceLine>
          <SourceLine>// Button Left Cap</SourceLine>
          <SourceLine>g.DrawPicture(Button_Pressed_Grey_Left, 0, 0)</SourceLine>
          <SourceLine>// Button Centre Stretch</SourceLine>
          <SourceLine>g.DrawPicture(Button_Pressed_Grey_Middle, Button_Pressed_Grey_Left.Width, 0,  g.Width - Button_Pressed_Grey_Left.Width - Button_Pressed_Grey_Right.Width , Button_Pressed_Grey_Middle.Height, 0, 0, Button_Pressed_Grey_Middle.Width, Button_Pressed_Grey_Middle.Height)</SourceLine>
          <SourceLine>// Button Right Cap</SourceLine>
          <SourceLine>g.DrawPicture(Button_Pressed_Grey_Right, g.Width - Button_Pressed_Grey_Right.Width, 0)</SourceLine>
          <SourceLine/>
          <SourceLine>// Text Black</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(19, 19, 19)</SourceLine>
          <SourceLine>ElseIf State = "Enter" Then</SourceLine>
          <SourceLine>// Button Left Cap</SourceLine>
          <SourceLine>g.DrawPicture(Button_Default_Grey_Left, 0, 0)</SourceLine>
          <SourceLine>// Button Centre Stretch</SourceLine>
          <SourceLine>g.DrawPicture(Button_Default_Grey_Middle, Button_Pressed_Grey_Left.Width, 0,  g.Width - Button_Pressed_Grey_Left.Width - Button_Pressed_Grey_Right.Width , Button_Pressed_Grey_Middle.Height, 0, 0, Button_Pressed_Grey_Middle.Width, Button_Pressed_Grey_Middle.Height)</SourceLine>
          <SourceLine>// Button Right Cap</SourceLine>
          <SourceLine>g.DrawPicture(Button_Default_Grey_Right, g.Width - Button_Pressed_Grey_Right.Width, 0)</SourceLine>
          <SourceLine/>
          <SourceLine>// Text Black</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(19, 19, 19)</SourceLine>
          <SourceLine>ElseIf State = "Exit" Then</SourceLine>
          <SourceLine>// Button Left Cap</SourceLine>
          <SourceLine>g.DrawPicture(Button_Inactive_Grey_Left, 0, 0)</SourceLine>
          <SourceLine>// Button Centre Stretch</SourceLine>
          <SourceLine>g.DrawPicture(Button_Inactive_Grey_Middle, Button_Pressed_Grey_Left.Width, 0,  g.Width - Button_Pressed_Grey_Left.Width - Button_Pressed_Grey_Right.Width , Button_Pressed_Grey_Middle.Height, 0, 0, Button_Pressed_Grey_Middle.Width, Button_Pressed_Grey_Middle.Height)</SourceLine>
          <SourceLine>// Button Right Cap</SourceLine>
          <SourceLine>g.DrawPicture(Button_Inactive_Grey_Right, g.Width - Button_Pressed_Grey_Right.Width, 0)</SourceLine>
          <SourceLine/>
          <SourceLine>// Text JustCropIt Off White Color</SourceLine>
          <SourceLine>// g.DrawingColor = Color.RGB(149, 149, 149)</SourceLine>
