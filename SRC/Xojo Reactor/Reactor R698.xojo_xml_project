        <SourceLine/>
        <SourceLine>// Info bar logging detail level</SourceLine>
        <SourceLine>json.Value("InfobarEventDetails") = App.InfobarEventDetails</SourceLine>
        <SourceLine/>
        <SourceLine>// Gamepad support for Playstation Dualshock controller</SourceLine>
