        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub DocumentOpened(item As FolderItem)</SourceLine>
        <SourceLine>// Drag Drop handler to import an Reactor Atomz favorite list (.lst) document</SourceLine>
        <SourceLine>If item &lt;&gt; Nil and item.Exists = True Then</SourceLine>
        <SourceLine>Try</SourceLine>
        <SourceLine>// Force open the Reactor window if required</SourceLine>
        <SourceLine>If ReactorWindow.Visible = False Then</SourceLine>
        <SourceLine>ReactorWindow.Show</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>// Import the .lst text file</SourceLine>
        <SourceLine>ReactorWindow.LoadAtomzList(item)</SourceLine>
        <SourceLine>Catch error As UnsupportedFormatException</SourceLine>
        <SourceLine>// Display log output at medium verbosity levels</SourceLine>
        <SourceLine>If App.InfobarEventDetails &gt;= 2 Then</SourceLine>
        <SourceLine>// MessageBox(error.Message + " - " + App.DownloadFolderItem.NativePath)</SourceLine>
        <SourceLine>ReactorWindow.DownloadStatsLabel.Text = error.Message + " - " + App.DownloadFolderItem.NativePath</SourceLine>
        <SourceLine>ConsoleWindow.Console.AddText(ReactorWindow.DownloadStatsLabel.Text + EndOfLine)</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>End Try</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>End Sub</SourceLine>
      </ItemSource>
    </HookInstance>
