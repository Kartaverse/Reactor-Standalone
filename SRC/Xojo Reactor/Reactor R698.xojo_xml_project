        <ItemName>SelectionChanged</ItemName>
        <Compatibility/>
        <Visible>1</Visible>
        <PartID>927277055</PartID>
        <ItemSource>
          <TextEncoding>134217984</TextEncoding>
          <SourceLine>Sub SelectionChanged()</SourceLine>
          <SourceLine>Try</SourceLine>
          <SourceLine>Var row As Integer = Me.SelectedRowIndex</SourceLine>
          <SourceLine/>
          <SourceLine>If row = -1 Then</SourceLine>
          <SourceLine>// Nothing is selected so dim the install/update/remove buttons</SourceLine>
          <SourceLine>InstallButtonState = "Inactive"</SourceLine>
          <SourceLine>UpdateButtonState = "Inactive"</SourceLine>
          <SourceLine>RemoveButtonState = "Inactive"</SourceLine>
          <SourceLine/>
          <SourceLine>InstallButton.Refresh(False)</SourceLine>
          <SourceLine>UpdateButton.Refresh(False)</SourceLine>
          <SourceLine>RemoveButton.Refresh(False)</SourceLine>
          <SourceLine>ElseIf row &gt;= 0 Then</SourceLine>
          <SourceLine>// Something is selected so brighten the install/update/remove buttons</SourceLine>
          <SourceLine>InstallButtonState = "Up"</SourceLine>
          <SourceLine>UpdateButtonState = "Up"</SourceLine>
          <SourceLine>RemoveButtonState = "Up"</SourceLine>
          <SourceLine/>
          <SourceLine>InstallButton.Refresh(False)</SourceLine>
          <SourceLine>UpdateButton.Refresh(False)</SourceLine>
          <SourceLine>RemoveButton.Refresh(False)</SourceLine>
          <SourceLine/>
          <SourceLine>Var CellString As String = Me.CellTextAt(row, 1)</SourceLine>
          <SourceLine>Var AtomIndex As Integer = Me.CellTagAt(row, 1).IntegerValue</SourceLine>
          <SourceLine>If App.Atoms.HasKey(AtomIndex.ToString()) Then</SourceLine>
          <SourceLine>Var Atom As JSONItem = App.Atoms.Value(AtomIndex.ToString())</SourceLine>
          <SourceLine>Var AtomDescription As String =  Atom.Value("Description")</SourceLine>
          <SourceLine>Var AtomID As String =  Atom.Value("ID")</SourceLine>
          <SourceLine>Var SelectedAtom As String = AtomID</SourceLine>
          <SourceLine/>
          <SourceLine>// Display log output at medium verbosity levels</SourceLine>
          <SourceLine>If App.InfobarEventDetails &gt;= 2 Then</SourceLine>
          <SourceLine>System.DebugLog("[Atom Selected] " + SelectedAtom)</SourceLine>
          <SourceLine>DownloadStatsLabel.Text = SelectedAtom + ".zip Selected"</SourceLine>
          <SourceLine>ConsoleWindow.Console.AddText(ReactorWindow.DownloadStatsLabel.Text + EndOfLine)</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>Var HTML As String = App.Header + AtomDescription + HTMLDonation(Atom) +  HTMLDependencies(Atom) + HTMLDeployFilesList(Atom) + App.Footer</SourceLine>
          <SourceLine>Var DeployHTMLFile As FolderItem = App.ReactorFolder.Child("Deploy").TemporaryFile.Child("index.html")</SourceLine>
          <SourceLine/>
          <SourceLine>DescriptionHTMLViewer.LoadPage(HTML, DeployHTMLFile)</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>End</SourceLine>
          <SourceLine/>
          <SourceLine>// Row selection bold highlight</SourceLine>
          <SourceLine>For r As Integer = Me.RowCount -1 DownTo 0</SourceLine>
          <SourceLine>if Me.SelectedRowIndex = r Then</SourceLine>
          <SourceLine>Me.CellBoldAt(r, 0) = True</SourceLine>
          <SourceLine>Else</SourceLine>
          <SourceLine>Me.CellBoldAt(r, 0) = False</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>Next</SourceLine>
          <SourceLine/>
          <SourceLine>// Push the input focus to the atom description views</SourceLine>
          <SourceLine>// DescriptionHTMLViewer.SetFocus()</SourceLine>
          <SourceLine>Catch error As OutOfBoundsException</SourceLine>
          <SourceLine>// Handle IO error</SourceLine>
          <SourceLine>// Display log output at medium verbosity levels</SourceLine>
          <SourceLine>If App.InfobarEventDetails &gt;= 2 Then</SourceLine>
          <SourceLine>// MessageBox(error.Message)</SourceLine>
          <SourceLine>ReactorWindow.DownloadStatsLabel.Text = error.Message</SourceLine>
          <SourceLine>ConsoleWindow.Console.AddText(ReactorWindow.DownloadStatsLabel.Text + EndOfLine)</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>Catch error As KeyNotFoundException</SourceLine>
          <SourceLine>// Handle IO error</SourceLine>
          <SourceLine>// Display log output at medium verbosity levels</SourceLine>
          <SourceLine>If App.InfobarEventDetails &gt;= 2 Then</SourceLine>
          <SourceLine>// MessageBox(error.Message)</SourceLine>
          <SourceLine>ReactorWindow.DownloadStatsLabel.Text = error.Message</SourceLine>
          <SourceLine>ConsoleWindow.Console.AddText(ReactorWindow.DownloadStatsLabel.Text + EndOfLine)</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>Catch error As IOException</SourceLine>
          <SourceLine>// Handle IO error</SourceLine>
          <SourceLine>// Display log output at medium verbosity levels</SourceLine>
          <SourceLine>If App.InfobarEventDetails &gt;= 2 Then</SourceLine>
          <SourceLine>// MessageBox(error.Message)</SourceLine>
          <SourceLine>ReactorWindow.DownloadStatsLabel.Text = error.Message</SourceLine>
          <SourceLine>ConsoleWindow.Console.AddText(ReactorWindow.DownloadStatsLabel.Text + EndOfLine)</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>End Try</SourceLine>
          <SourceLine/>
          <SourceLine/>
          <SourceLine>End Sub</SourceLine>
        </ItemSource>
