        <PartID>191836159</PartID>
        <ItemSource>
          <TextEncoding>134217984</TextEncoding>
          <SourceLine>Sub MouseUp(x As Integer, y As Integer)</SourceLine>
          <SourceLine>InstallButtonState = "Up"</SourceLine>
          <SourceLine>Me.Refresh</SourceLine>
          <SourceLine/>
          <SourceLine>For row As Integer = 0 To AtomsListBox.LastRowIndex</SourceLine>
          <SourceLine>If AtomsListBox.RowSelectedAt(row) Then</SourceLine>
          <SourceLine>Var CellString As String = AtomsListBox.CellTextAt(row, 1)</SourceLine>
          <SourceLine>Var AtomIndex As Integer = AtomsListBox.CellTagAt(row, 1).IntegerValue</SourceLine>
          <SourceLine>Var Atom As JSONItem = App.Atoms.Value(AtomIndex.ToString())</SourceLine>
          <SourceLine>If Atom &lt;&gt; Nil Then</SourceLine>
          <SourceLine>Var AtomDescription As String =  Atom.Value("Description")</SourceLine>
          <SourceLine>Var AtomID As String =  Atom.Value("ID")</SourceLine>
          <SourceLine>Var SelectedAtom As String = AtomID</SourceLine>
          <SourceLine/>
          <SourceLine>System.DebugLog("[Install Button] " + SelectedAtom)</SourceLine>
          <SourceLine/>
          <SourceLine>// Push the input focus to the atom description views</SourceLine>
          <SourceLine>DescriptionHTMLViewer.SetFocus()</SourceLine>
          <SourceLine/>
          <SourceLine>// Is the atom installed already</SourceLine>
          <SourceLine>Var InstallState As Boolean = AtomInstalled(AtomID)</SourceLine>
          <SourceLine/>
          <SourceLine>// Verify no active downloads are in progress</SourceLine>
          <SourceLine>If AtomUpdateAvailable(AtomID) = True then</SourceLine>
          <SourceLine>// Cancel the download task, and update the atom package</SourceLine>
          <SourceLine>AtomRemoveByRow(row)</SourceLine>
          <SourceLine>AtomDownloadQueue(AtomID, Atom)</SourceLine>
          <SourceLine>Else</SourceLine>
          <SourceLine>AtomDownloadQueue(AtomID, Atom)</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>// Checkbox Cell</SourceLine>
          <SourceLine>AtomsListBox.RefreshCell(row, 0)</SourceLine>
          <SourceLine/>
          <SourceLine>AtomsListBox.CellTextAt(row, 6) = "Queued"</SourceLine>
          <SourceLine>AtomsListBox.RefreshCell(row, 6)</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>Next</SourceLine>
          <SourceLine/>
          <SourceLine>// Update the number next to the state rows</SourceLine>
          <SourceLine>//RefreshStateCount()</SourceLine>
          <SourceLine/>
          <SourceLine>// Update the number next to the category rows</SourceLine>
          <SourceLine>RefreshCategoryCount()</SourceLine>
          <SourceLine/>
          <SourceLine>// Rebuild the atoms list</SourceLine>
          <SourceLine>RefreshAtoms()</SourceLine>
          <SourceLine>End Sub</SourceLine>
        </ItemSource>
      </HookInstance>
