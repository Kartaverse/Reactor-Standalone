    <Compatibility/>
    <HookInstance>
      <ItemName>Opening</ItemName>
      <Compatibility/>
      <Visible>1</Visible>
      <PartID>1196244991</PartID>
      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub Opening()</SourceLine>
        <SourceLine>If TargetMacOS Then</SourceLine>
        <SourceLine>Me.Title = "Reactor Settings"</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Turn the download queue off</SourceLine>
        <SourceLine>// Display log output at low verbosity levels</SourceLine>
        <SourceLine>If App.InfobarEventDetails &gt;= 1 Then</SourceLine>
        <SourceLine>ReactorWindow.DownloadStatsLabel.Text = "Download Queue Inactive While Preferences Window Open"</SourceLine>
        <SourceLine>ConsoleWindow.Console.AddText(ReactorWindow.DownloadStatsLabel.Text + EndOfLine)</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Stop the download queue</SourceLine>
        <SourceLine>ReactorWindow.TimerQueue.RunMode = Timer.RunModes.Off</SourceLine>
        <SourceLine>// ReactorWindow.AtomDownloadCancel()</SourceLine>
        <SourceLine/>
        <SourceLine>// Window sizing</SourceLine>
        <SourceLine>If ReactorWindow.Visible = True Then</SourceLine>
        <SourceLine>Me.Top = DesktopDisplay.DisplayAt(0).AvailableTop + 28 + (ReactorWindow.Height / 2) - (Me.Height / 2)</SourceLine>
        <SourceLine>Me.Left = ReactorWindow.Left + (ReactorWindow.Width / 2) - (Me.Width / 2)</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Gamepad support</SourceLine>
        <SourceLine>If App.GamepadSupport = 1 Then</SourceLine>
        <SourceLine>GamepadSupportCheckBoxState = True</SourceLine>
        <SourceLine>ElseIf App.GamepadSupport = 0 Then</SourceLine>
        <SourceLine>GamepadSupportCheckBoxState = False</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Search</SourceLine>
        <SourceLine>If App.LiveSearch = True Then</SourceLine>
        <SourceLine>LiveSearchCheckboxState = True</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>LiveSearchCheckboxState = False</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>End Sub</SourceLine>
      </ItemSource>
    </HookInstance>
    <HookInstance>
      <ItemName>Closing</ItemName>
      <Compatibility/>
      <Visible>1</Visible>
      <PartID>60852223</PartID>
      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub Closing()</SourceLine>
        <SourceLine>// Turn the download queue back on</SourceLine>
        <SourceLine>// Display log output at low verbosity levels</SourceLine>
        <SourceLine>If App.InfobarEventDetails &gt;= 1 Then</SourceLine>
        <SourceLine>ReactorWindow.DownloadStatsLabel.Text = "Download Queue Active"</SourceLine>
        <SourceLine>ConsoleWindow.Console.AddText(ReactorWindow.DownloadStatsLabel.Text + EndOfLine)</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>ReactorWindow.TimerQueue.RunMode = Timer.RunModes.Multiple</SourceLine>
        <SourceLine/>
        <SourceLine>End Sub</SourceLine>
      </ItemSource>
    </HookInstance>
